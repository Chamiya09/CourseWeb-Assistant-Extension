{
  "manifest_version": 3,
  "name": "CourseWeb Assistant",
  "version": "1.0",
  "description": "Tracks SLIIT CourseWeb deadlines directly from the Nav Bar.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://courseweb.sliit.lk/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}